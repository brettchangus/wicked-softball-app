# Copy this file to `.env` and fill in your real key. `.env` is gitignored.
# `netlify dev` loads these automatically when running functions locally.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin/setup protection (ADMIN_SECRET and NOTIFY_SECRET fall back to SETUP_SECRET).
SETUP_SECRET=replace-me
ADMIN_SECRET=replace-me
NOTIFY_SECRET=replace-me

# Web push.
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com
GEOCODE_USER_AGENT=wicked-softball-app (your contact URL or email)
