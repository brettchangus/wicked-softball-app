{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["lib/scouting*.ts", "lib/gamechanger-scouting.ts", "scouting-report.ts", "../../tests/scouting*.test.mts", "../../tests/gamechanger-scouting.test.mts"]
}
